# Backend listens on PORT (default 3000). Never put provider/storage secrets in frontend variables.
PORT=3000
OPENMUSE_API_BASE_URL=https://openmuse-api-yjd904.v2.appdeploy.ai/api/v1

# OpenAI-compatible provider configuration; absent credentials disable generation routes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENMUSE_TEXT_MODEL=
# Set true only after verifying native SSE streaming for this provider/model.
OPENMUSE_TEXT_STREAMING_ENABLED=false
OPENMUSE_VISION_MODEL=
OPENMUSE_IMAGE_MODEL=

# Abuse/cost safeguards. Limits are per process unless a shared limiter is deployed.
OPENMUSE_REQUEST_TIMEOUT_MS=30000
OPENMUSE_MAX_OUTPUT_TOKENS=4096
OPENMUSE_MAX_REQUEST_BODY_BYTES=8388608
OPENMUSE_RATE_LIMIT_WINDOW_MS=60000
OPENMUSE_RATE_LIMIT_MAX_REQUESTS=30
OPENMUSE_EXPENSIVE_RATE_LIMIT_MAX_REQUESTS=3
OPENMUSE_MAX_CONCURRENT_GENERATIONS=4

# Image retention. In-memory fallback is non-durable; configure S3-compatible object storage for persistence.
OPENMUSE_IMAGE_RETENTION_DAYS=7
OPENMUSE_S3_BUCKET=
OPENMUSE_S3_REGION=us-east-1
# Optional S3-compatible endpoint, such as a private object-store URL (server-side only).
OPENMUSE_S3_ENDPOINT=
OPENMUSE_S3_FORCE_PATH_STYLE=false
# Standard AWS credentials/role environment variables are read by the AWS SDK; never expose them to clients.
