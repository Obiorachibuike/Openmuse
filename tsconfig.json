{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "declaration": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"], "noUncheckedIndexedAccess": true
  },
  "include": ["src/backend/**/*.ts"],
  "exclude": ["src/backend/**/*.test.ts", "src/backend/**/*.spec.ts"]
}
