{
  "name": "openmuse-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/javascript"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx src/backend/server.ts",
    "start": "node dist/backend/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run build:api && npm run build:web && npm run build:sdk",
    "build:api": "node scripts/clean-api-dist.mjs && tsc -p tsconfig.json",
    "build:web": "vite build",
    "build:sdk": "npm run build --workspace=@openmuse-ai/sdk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm run typecheck --workspace=@openmuse-ai/sdk",
    "test:python": "python -m pytest packages/python/tests",
    "validate:openapi": "python scripts/validate_openapi.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@hono/node-server": "^1.15.0",
    "hono": "^4.8.0",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.12"
  }
}
